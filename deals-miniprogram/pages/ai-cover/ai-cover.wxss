/* pages/ai-cover/ai-cover.wxss */
.placeholder-container {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
}

.placeholder-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.placeholder-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 20rpx;
}

.placeholder-desc {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 40rpx;
}

.placeholder-tip {
  font-size: 26rpx;
  color: #999;
  background: #f5f5f5;
  padding: 16rpx 40rpx;
  border-radius: 30rpx;
}
