/* pages/tool-search/tool-search.wxss */
.search-container {
  min-height: 100vh;
  background: #f5f5f5;
}

/* 搜索框 */
.search-bar {
  background: #fff;
  padding: 20rpx 30rpx;
  position: sticky;
  top: 0;
  z-index: 100;
}

.search-input-wrap {
  display: flex;
  align-items: center;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 24rpx;
  height: 72rpx;
}

.search-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.search-input {
  flex: 1;
  font-size: 28rpx;
  color: #333;
}

.clear-btn {
  font-size: 28rpx;
  color: #999;
  padding: 8rpx 16rpx;
}

/* 分区标题 */
.section-title {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  padding: 30rpx 30rpx 16rpx;
}

/* 热门标签 */
.hot-section {
  background: #fff;
  padding-bottom: 20rpx;
}

.hot-tags {
  display: flex;
  flex-wrap: wrap;
  padding: 0 30rpx;
  gap: 16rpx;
}

.hot-tag {
  font-size: 26rpx;
  color: #ff4d4f;
  background: #fff2f0;
  border: 1rpx solid #ffccc7;
  padding: 10rpx 24rpx;
  border-radius: 30rpx;
}

/* 工具列表 */
.all-section,
.result-section {
  background: #fff;
  margin-top: 16rpx;
}

.tool-list {
  padding: 0 30rpx;
}

.tool-item {
  display: flex;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}

.tool-item:last-child {
  border-bottom: none;
}

.tool-item-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  margin-right: 24rpx;
}

.tool-item-info {
  flex: 1;
}

.tool-item-name {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 6rpx;
}

.tool-item-desc {
  font-size: 24rpx;
  color: #999;
}

.tool-item-arrow {
  font-size: 36rpx;
  color: #ccc;
}

/* 空结果 */
.empty-result {
  text-align: center;
  padding: 120rpx 40rpx;
}

.empty-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #999;
}
