/* 全局样式 */
page {
  background-color: #f5f5f5;
  font-family: -apple-system, BlinkMacSystemFont, 'Helvetica Neue', Helvetica, 'PingFang SC', 'Hiragino Sans GB', 'Microsoft YaHei', Arial, sans-serif;
}

.container {
  padding: 20rpx;
}

/* 搜索栏 */
.search-bar {
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx;
  background: #fff;
  position: sticky;
  top: 0;
  z-index: 100;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.search-input {
  flex: 1;
  height: 72rpx;
  background: #f5f5f5;
  border-radius: 36rpx;
  padding: 0 30rpx;
  font-size: 28rpx;
}

.search-btn {
  margin-left: 20rpx;
  background: #ff4d4f;
  color: #fff;
  font-size: 28rpx;
  border-radius: 36rpx;
  padding: 0 40rpx;
  height: 72rpx;
  line-height: 72rpx;
  border: none;
}

/* 品类标签 */
.category-tabs {
  display: flex;
  overflow-x: auto;
  white-space: nowrap;
  padding: 20rpx 30rpx;
  background: #fff;
  margin-bottom: 20rpx;
}

.category-tab {
  display: inline-block;
  padding: 12rpx 30rpx;
  margin-right: 16rpx;
  background: #f5f5f5;
  border-radius: 30rpx;
  font-size: 26rpx;
  color: #666;
  flex-shrink: 0;
}

.category-tab.active {
  background: #ff4d4f;
  color: #fff;
}

/* 商品卡片 */
.deal-list {
  padding: 0 20rpx;
}

.deal-card {
  background: #fff;
  border-radius: 16rpx;
  margin-bottom: 20rpx;
  overflow: hidden;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

.deal-image {
  width: 100%;
  height: 400rpx;
  background: #f0f0f0;
}

.deal-info {
  padding: 20rpx;
}

.deal-title {
  font-size: 28rpx;
  color: #333;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 2;
  -webkit-box-orient: vertical;
  overflow: hidden;
  margin-bottom: 12rpx;
}

.deal-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
}

.deal-price {
  font-size: 36rpx;
  color: #ff4d4f;
  font-weight: bold;
}

.deal-price-symbol {
  font-size: 24rpx;
}

.deal-original-price {
  font-size: 24rpx;
  color: #999;
  text-decoration: line-line-through;
  margin-left: 12rpx;
}

.deal-discount {
  background: linear-gradient(135deg, #ff4d4f, #ff7875);
  color: #fff;
  font-size: 22rpx;
  padding: 4rpx 16rpx;
  border-radius: 20rpx;
}

.deal-shop {
  font-size: 22rpx;
  color: #999;
  margin-top: 8rpx;
}

.deal-tags {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.deal-tag {
  font-size: 20rpx;
  color: #ff4d4f;
  border: 1rpx solid #ff4d4f;
  border-radius: 8rpx;
  padding: 2rpx 12rpx;
  margin-right: 12rpx;
  margin-bottom: 8rpx;
}

/* 加载状态 */
.loading {
  text-align: center;
  padding: 40rpx;
  color: #999;
  font-size: 26rpx;
}

.empty {
  text-align: center;
  padding: 100rpx 40rpx;
  color: #999;
}

.empty-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

/* 更新时间 */
.update-time {
  text-align: center;
  font-size: 22rpx;
  color: #bbb;
  padding: 30rpx;
}
